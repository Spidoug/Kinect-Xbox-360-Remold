SimpleFrameGenerator::~SimpleFrameGenerator()
{
    StopSmartEngine();
    CloseMapping();
}

HRESULT SimpleFrameGenerator::Initialize(_In_ IMFMediaType* pMediaType)
{
    RETURN_HR_IF_NULL(E_INVALIDARG, pMediaType);
    RETURN_IF_FAILED(pMediaType->GetGUID(MF_MT_SUBTYPE, &m_subType));
    if (m_subType != MFVideoFormat_NV12 && m_subType != MFVideoFormat_YUY2 &&
        m_subType != MFVideoFormat_RGB32)
        return MF_E_UNSUPPORTED_FORMAT;
    RETURN_IF_FAILED(MFGetAttributeSize(pMediaType, MF_MT_FRAME_SIZE, &m_width, &m_height));
    if (m_width != kWidth || m_height != kHeight) return MF_E_UNSUPPORTED_FORMAT;
    try {
        m_latestNv12.resize(kNv12Bytes);
        m_framedNv12.resize(kNv12Bytes);
    } catch (...) {
        return E_OUTOFMEMORY;
    }
    StartSmartEngine();
    return S_OK;
}

HRESULT SimpleFrameGenerator::EnsureMapping()
{
    if (m_mapping && m_base) return S_OK;
    CloseMapping();
    m_mapping = OpenFileMappingW(FILE_MAP_READ, FALSE, kMappingName);
    if (!m_mapping) return HRESULT_FROM_WIN32(GetLastError());
    m_base = MapViewOfFile(m_mapping, FILE_MAP_READ, 0, 0, kMappingBytes);
    if (!m_base) {
        HRESULT hr = HRESULT_FROM_WIN32(GetLastError());
        CloseMapping();
        return hr;
    }
    const auto* h = static_cast<const SharedHeader*>(m_base);
    if (h->magic != kMagic || h->version != kVersion || h->width != kWidth ||
        h->height != kHeight || h->fourcc != kNv12Fourcc ||
        h->frameBytes != kNv12Bytes || h->slotCount != kSlotCount) {
        CloseMapping();
        return HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
    }
    return S_OK;
}

bool SimpleFrameGenerator::ReadLatestNv12()
{
    if (m_latestNv12.size() != kNv12Bytes) return false;
    if (FAILED(EnsureMapping())) return false;
    return CopyLatestNv12FromMapping(m_mapping, m_base, m_latestNv12);
}

void SimpleFrameGenerator::ApplyDigitalFraming()
{
    if (m_framedNv12.size() != kNv12Bytes || m_latestNv12.size() != kNv12Bytes) return;
    auto& state = CameraControls::Global();
    LONG zoom = CameraControls::ClampLong(state.zoomPermille.load(), kZoomMinimumPermille, kZoomMaximumPermille);
    LONG pan = CameraControls::ClampLong(state.panDegrees.load(), kPanMinimum, kPanMaximum);
    LONG vertical = CameraControls::ClampLong(state.verticalCropPermille.load(), -1000, 1000);
    if (zoom == 1000 && pan == 0 && vertical == 0) {
        std::memcpy(m_framedNv12.data(), m_latestNv12.data(), kNv12Bytes);
        return;
    }
    // Digital pan/vertical correction needs crop margin.  A small implicit crop
    // makes a manual Pan useful even when the client has left Zoom at 1.0x.
    if ((pan != 0 || vertical != 0) && zoom < 1100) zoom = 1100;

    uint32_t cropW = static_cast<uint32_t>((static_cast<uint64_t>(kWidth) * 1000u) / static_cast<uint32_t>(zoom));
    uint32_t cropH = static_cast<uint32_t>((static_cast<uint64_t>(kHeight) * 1000u) / static_cast<uint32_t>(zoom));
    if (cropW < 2) cropW = 2;
    if (cropH < 2) cropH = 2;
    cropW &= ~1u;
    cropH &= ~1u;
    if (cropW > kWidth) cropW = kWidth;
    if (cropH > kHeight) cropH = kHeight;

    const LONG spareX = static_cast<LONG>(kWidth - cropW);
    const LONG spareY = static_cast<LONG>(kHeight - cropH);
    LONG cropX = spareX / 2;
    LONG cropY = spareY / 2;
    if (spareX > 0) cropX += (pan * spareX) / (2 * kPanMaximum);
    if (spareY > 0) cropY += (vertical * spareY) / 2000;
    cropX = CameraControls::ClampLong(cropX, 0, spareX) & ~1L;
    cropY = CameraControls::ClampLong(cropY, 0, spareY) & ~1L;

    const BYTE* sourceY = m_latestNv12.data();
    const BYTE* sourceUv = sourceY + kWidth * kHeight;
    BYTE* targetY = m_framedNv12.data();
    BYTE* targetUv = targetY + kWidth * kHeight;

    for (uint32_t y = 0; y < kHeight; ++y) {
        const uint32_t sy = static_cast<uint32_t>(cropY) + (y * cropH) / kHeight;
        const BYTE* row = sourceY + static_cast<size_t>(sy) * kWidth;
        BYTE* out = targetY + static_cast<size_t>(y) * kWidth;
        for (uint32_t x = 0; x < kWidth; ++x) {
            const uint32_t sx = static_cast<uint32_t>(cropX) + (x * cropW) / kWidth;
            out[x] = row[sx];
        }
    }

    for (uint32_t y = 0; y < kHeight / 2; ++y) {
        uint32_t sy = static_cast<uint32_t>(cropY) / 2u + (y * (cropH / 2u)) / (kHeight / 2u);
        const BYTE* row = sourceUv + static_cast<size_t>(sy) * kWidth;
        BYTE* out = targetUv + static_cast<size_t>(y) * kWidth;
        for (uint32_t x = 0; x < kWidth; x += 2) {
            uint32_t sx = static_cast<uint32_t>(cropX) + (x * cropW) / kWidth;
            sx &= ~1u;
            if (sx + 1 >= kWidth) sx = kWidth - 2;
            out[x] = row[sx];
            out[x + 1] = row[sx + 1];
        }
    }
}

HRESULT SimpleFrameGenerator::WriteNv12(BYTE* pBuf, DWORD len, LONG pitch) const
{
    if (pitch < static_cast<LONG>(kWidth)) return E_INVALIDARG;
    const uint64_t required = static_cast<uint64_t>(pitch) * kHeight * 3ull / 2ull;
    if (required > len) return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
    const BYTE* srcY = m_framedNv12.data();
    for (uint32_t y = 0; y < kHeight; ++y)
        std::memcpy(pBuf + static_cast<size_t>(y) * pitch, srcY + static_cast<size_t>(y) * kWidth, kWidth);
    const BYTE* srcUv = srcY + kWidth * kHeight;
    BYTE* dstUv = pBuf + static_cast<size_t>(pitch) * kHeight;
    for (uint32_t y = 0; y < kHeight / 2; ++y)
        std::memcpy(dstUv + static_cast<size_t>(y) * pitch, srcUv + static_cast<size_t>(y) * kWidth, kWidth);
    return S_OK;
}

HRESULT SimpleFrameGenerator::WriteYuy2(BYTE* pBuf, DWORD len, LONG pitch) const
{
    constexpr LONG kYuy2RowBytes = static_cast<LONG>(kWidth * 2u);
    if (pitch < kYuy2RowBytes) return E_INVALIDARG;
    const uint64_t required = static_cast<uint64_t>(pitch) * kHeight;
    if (required > len) return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
    const BYTE* yPlane = m_framedNv12.data();
    const BYTE* uvPlane = yPlane + kWidth * kHeight;
    for (uint32_t y = 0; y < kHeight; ++y) {
        const BYTE* srcY = yPlane + static_cast<size_t>(y) * kWidth;
        const BYTE* srcUv = uvPlane + static_cast<size_t>(y / 2u) * kWidth;
        BYTE* dst = pBuf + static_cast<size_t>(y) * pitch;
        for (uint32_t x = 0; x < kWidth; x += 2) {
            dst[2u * x + 0] = srcY[x + 0];
            dst[2u * x + 1] = srcUv[x + 0];
            dst[2u * x + 2] = srcY[x + 1];
            dst[2u * x + 3] = srcUv[x + 1];
        }
    }
    return S_OK;
}

HRESULT SimpleFrameGenerator::WriteRgb32(BYTE* pBuf, DWORD len, LONG pitch) const
{
    constexpr LONG kRgbRowBytes = static_cast<LONG>(kWidth * 4u);
    if (pitch < kRgbRowBytes) return E_INVALIDARG;
    const uint64_t required = static_cast<uint64_t>(pitch) * kHeight;
    if (required > len) return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
    const BYTE* yPlane = m_framedNv12.data();
    const BYTE* uvPlane = yPlane + kWidth * kHeight;
    auto clamp8 = [](int value) -> BYTE {
        if (value < 0) return 0;
        if (value > 255) return 255;
        return static_cast<BYTE>(value);
    };
    for (uint32_t y = 0; y < kHeight; ++y) {
        const BYTE* srcY = yPlane + static_cast<size_t>(y) * kWidth;
        const BYTE* srcUv = uvPlane + static_cast<size_t>(y / 2u) * kWidth;
        BYTE* dst = pBuf + static_cast<size_t>(y) * pitch;
        for (uint32_t x = 0; x < kWidth; ++x) {
            const int ySample = static_cast<int>(srcY[x]) - 16;
            const int c = (ySample > 0) ? ySample : 0;
            const uint32_t uvx = x & ~1u;
            const int d = static_cast<int>(srcUv[uvx]) - 128;
            const int e = static_cast<int>(srcUv[uvx + 1]) - 128;
            dst[4u * x + 0] = clamp8((298 * c + 516 * d + 128) >> 8);
            dst[4u * x + 1] = clamp8((298 * c - 100 * d - 208 * e + 128) >> 8);
            dst[4u * x + 2] = clamp8((298 * c + 409 * e + 128) >> 8);
            dst[4u * x + 3] = 0;
        }
    }
    return S_OK;
}

HRESULT SimpleFrameGenerator::WriteBlackFrame(BYTE* pBuf, DWORD len, LONG pitch) const
{
    if (m_subType == MFVideoFormat_NV12) {
        if (pitch < static_cast<LONG>(kWidth)) return E_INVALIDARG;
        const uint64_t required = static_cast<uint64_t>(pitch) * kHeight * 3ull / 2ull;
        if (required > len) return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
        for (uint32_t y = 0; y < kHeight; ++y) std::memset(pBuf + static_cast<size_t>(y) * pitch, 16, kWidth);
        BYTE* uv = pBuf + static_cast<size_t>(pitch) * kHeight;
        for (uint32_t y = 0; y < kHeight / 2; ++y) std::memset(uv + static_cast<size_t>(y) * pitch, 128, kWidth);
        return S_OK;
    }
    if (m_subType == MFVideoFormat_YUY2) {
        constexpr LONG rowBytes = static_cast<LONG>(kWidth * 2u);
        if (pitch < rowBytes || static_cast<uint64_t>(pitch) * kHeight > len) return E_INVALIDARG;
        for (uint32_t y = 0; y < kHeight; ++y) {
            BYTE* dst = pBuf + static_cast<size_t>(y) * pitch;
            for (uint32_t x = 0; x < kWidth; x += 2) { dst[2*x]=16; dst[2*x+1]=128; dst[2*x+2]=16; dst[2*x+3]=128; }
        }
        return S_OK;
    }
    if (m_subType == MFVideoFormat_RGB32) {
        constexpr LONG rowBytes = static_cast<LONG>(kWidth * 4u);
        if (pitch < rowBytes || static_cast<uint64_t>(pitch) * kHeight > len) return E_INVALIDARG;
        for (uint32_t y = 0; y < kHeight; ++y) std::memset(pBuf + static_cast<size_t>(y) * pitch, 0, kWidth * 4u);
        return S_OK;
    }
    return MF_E_UNSUPPORTED_FORMAT;
}

HRESULT SimpleFrameGenerator::CreateFrame(BYTE* pBuf, DWORD len, LONG pitch, ULONG)
{
    std::lock_guard<std::mutex> guard(m_lock);
    RETURN_HR_IF_NULL(E_INVALIDARG, pBuf);

    // A frame request is the authoritative RGB-camera usage signal. Lease it
    // to the persistent LED broker independently from FaceTracker support.
    const ULONGLONG now = GetTickCount64();
    const ULONGLONG lastActivity = m_lastRgbActivity.load(std::memory_order_relaxed);
    if (lastActivity == 0 || now - lastActivity >= kCameraActivityHeartbeatMs) {
        const HRESULT activityHr = SendControl(
            Control::Command::CameraActivity,
            static_cast<LONG>(Control::CameraActivitySource::VirtualCamera),
            nullptr,
            0);
        if (FAILED(activityHr)) CameraControls::Global().lastControlHresult.store(activityHr);
        m_lastRgbActivity.store(now, std::memory_order_relaxed);
    }
    if (!ReadLatestNv12()) return WriteBlackFrame(pBuf, len, pitch);
    ApplyDigitalFraming();
    if (m_subType == MFVideoFormat_NV12) return WriteNv12(pBuf, len, pitch);
    if (m_subType == MFVideoFormat_YUY2) return WriteYuy2(pBuf, len, pitch);
    if (m_subType == MFVideoFormat_RGB32) return WriteRgb32(pBuf, len, pitch);
    return MF_E_UNSUPPORTED_FORMAT;
}

void SimpleFrameGenerator::StartSmartEngine()
{
    bool expected = false;
    if (!m_engineRun.compare_exchange_strong(expected, true)) return;
    try {
        m_engineThread = std::thread(&SimpleFrameGenerator::SmartEngineLoop, this);
    } catch (...) {
        m_engineRun.store(false);
    }
}

void SimpleFrameGenerator::StopSmartEngine()
{
    if (!m_engineRun.exchange(false)) return;
    if (m_engineThread.joinable()) m_engineThread.join();
    CameraControls::Global().engineOnline.store(0);
}

void SimpleFrameGenerator::SmartEngineLoop()
{
    auto& state = CameraControls::Global();
    try { winrt::init_apartment(winrt::apartment_type::multi_threaded); }
    catch (const winrt::hresult_error& e) {
        state.lastControlHresult.store(e.code());
        return;
    }

    using namespace winrt::Windows::Graphics::Imaging;
    using namespace winrt::Windows::Media;
    using namespace winrt::Windows::Media::FaceAnalysis;
    using namespace winrt::Windows::Storage::Streams;

    winrt::Windows::Media::FaceAnalysis::FaceTracker tracker{nullptr};
    bool faceTrackerReady = false;
    try {
        if (FaceTracker::IsSupported() && FaceTracker::IsBitmapPixelFormatSupported(BitmapPixelFormat::Nv12)) {
            tracker = FaceTracker::CreateAsync().get();
            faceTrackerReady = true;
        } else {
            // Manual/continuous Tilt and hardware status remain available even when
            // Windows does not provide FaceTracker support.
            state.lastControlHresult.store(HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED));
        }
    } catch (const winrt::hresult_error& e) {
        state.lastControlHresult.store(e.code());
    }

    HANDLE mapping = nullptr;
    const void* mappingBase = nullptr;
    std::vector<BYTE> frame;
    try { frame.resize(kNv12Bytes); }
    catch (...) { state.lastControlHresult.store(E_OUTOFMEMORY); return; }

    ULONGLONG lastStatus = 0;
    ULONGLONG lastTilt = 0;
    ULONGLONG lastFace = GetTickCount64();
    LONG lastTiltSent = 999;
    LONG lastReportedTilt = 999;
    bool faceTiltTargetReady = false;
    double faceTiltTarget = static_cast<double>(kStartupTiltDegrees);
    bool faceErrorReady = false;
    double filteredFaceDy = 0.0;
    bool accelReady = false;
    double filteredAccelPitch = 0.0;
    double filteredAccelCorrection = 0.0;
    double accelMountBias = 0.0;
    int accelTiltSign = 0;
    double accelTiltSignScore = 0.0;
    bool previousAccelRelationSample = false;
    double previousAccelPitch = 0.0;
    LONG previousAccelTilt = 0;
    ULONGLONG lastGoodAccel = 0;
    state.stabilizationCorrectionTenths.store(0);
    state.engineOnline.store(0);

    while (m_engineRun.load()) {
        const ULONGLONG now = GetTickCount64();
        const ULONGLONG activityTick = m_lastRgbActivity.load(std::memory_order_relaxed);
        const bool virtualCameraActive = activityTick != 0 && now - activityTick <= kVirtualCameraActiveLeaseMs;
        if (!virtualCameraActive) {
            // Tilt + accelerometer stabilization + FaceTracker are exclusively a
            // virtual-camera feature. Merely keeping the media source/service alive
            // must not poll/move the motor when no application consumes frames.
            state.engineOnline.store(0);
            state.stabilizationCorrectionTenths.store(0);
            faceTiltTargetReady = false;
            faceErrorReady = false;
            filteredFaceDy = 0.0;
            filteredAccelCorrection = 0.0;
            lastTiltSent = 999;
            lastReportedTilt = 999;
            previousAccelRelationSample = false;
            accelReady = false;
            accelTiltSign = 0;
            accelTiltSignScore = 0.0;
            for (DWORD slept=0; slept<kFacePeriodMs && m_engineRun.load(); slept+=10) Sleep(10);
            continue;
        }
        state.engineOnline.store(1);
        if (!mapping) {
            mapping = OpenFileMappingW(FILE_MAP_READ, FALSE, kMappingName);
            if (mapping) mappingBase = MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, kMappingBytes);
            if (!mappingBase && mapping) { CloseHandle(mapping); mapping = nullptr; }
        }


        if (now - lastStatus >= kStatusPeriodMs) {
            Control::Reply reply{};
            HRESULT hr = SendControl(Control::Command::Status, 0, &reply);
            state.lastControlHresult.store(hr);
            if (SUCCEEDED(hr)) {
                state.accelX.store(reply.accelX); state.accelY.store(reply.accelY); state.accelZ.store(reply.accelZ);
                state.motorTransport.store(static_cast<LONG>(reply.transport));
                const LONG reportedTilt = CameraControls::ClampLong(RoundLong(reply.tiltTenths / 10.0), kTiltMinimum, kTiltMaximum);
                lastReportedTilt = reportedTilt;
                if (state.autoFraming.load()) {
                    // Warm-start from the measured physical angle. Opening a camera
                    // must not first jerk to the startup angle; auto-center remains
                    // responsible for returning there only after a long no-face period.
                    state.tiltDegrees.store(reportedTilt);
                    if (!faceTiltTargetReady) {
                        faceTiltTarget = static_cast<double>(reportedTilt);
                        faceTiltTargetReady = true;
                        lastTiltSent = reportedTilt;
                    }
                }

                // Stabilization is intentionally limited to the physical 02B0
                // path: its accelerometer scale/axes are defined and arrive in
                // the same status transaction as the measured motor angle.
                double accelPitch = 0.0;
                if (reply.transport == Control::Transport::PhysicalMotor &&
                    AccelPitchDegrees(reply.accelX, reply.accelY, reply.accelZ, accelPitch)) {
                    if (!accelReady) {
                        filteredAccelPitch = accelPitch;
                        accelReady = true;
                    } else {
                        filteredAccelPitch += (accelPitch - filteredAccelPitch) * kAccelFilterAlpha;
                    }

                    // Learn motor-to-accelerometer polarity from real movement.
                    // Different Kinect revisions/mounting conventions must not
                    // depend on a guessed sign for the Z-derived pitch angle.
                    if (previousAccelRelationSample) {
                        const double tiltDelta = static_cast<double>(reportedTilt - previousAccelTilt);
                        const double pitchDelta = filteredAccelPitch - previousAccelPitch;
                        if (std::abs(tiltDelta) >= 0.75) {
                            const double ratio = pitchDelta / tiltDelta;
                            if (std::abs(ratio) >= 0.20 && std::abs(ratio) <= 2.50) {
                                accelTiltSignScore = ClampDouble(
                                    accelTiltSignScore + (ratio > 0.0 ? 1.0 : -1.0), -4.0, 4.0);
                                const int learnedSign = accelTiltSignScore >= 2.0 ? 1 :
                                                        (accelTiltSignScore <= -2.0 ? -1 : 0);
                                if (learnedSign != 0 && learnedSign != accelTiltSign) {
                                    accelTiltSign = learnedSign;
                                    accelMountBias = filteredAccelPitch -
                                        static_cast<double>(accelTiltSign * reportedTilt);
                                }
                            }
                        }
                    }
                    previousAccelPitch = filteredAccelPitch;
                    previousAccelTilt = reportedTilt;
                    previousAccelRelationSample = true;
                    lastGoodAccel = now;
                } else if (reply.transport != Control::Transport::PhysicalMotor) {
                    accelReady = false;
                    accelTiltSign = 0;
                    accelTiltSignScore = 0.0;
                    previousAccelRelationSample = false;
                    state.stabilizationCorrectionTenths.store(0);
                }
            } else {
                state.motorTransport.store(0);
            }
            lastStatus = now;
        }

        bool gotFrame = mapping && mappingBase && CopyLatestNv12FromMapping(mapping, mappingBase, frame);
        FaceTarget target{};
        // FaceTracker is control-only: it analyzes a private copy of the RGB frame.
        // No face rectangle, landmark, overlay, or face metadata is ever drawn into
        // the Windows Camera image; only the internal Tilt/framing target is updated.
        if (faceTrackerReady && gotFrame && state.faceTracking.load()) {
            try {
                Buffer buffer(kNv12Bytes);
                buffer.Length(kNv12Bytes);
                BYTE* bytes = buffer.data();
                if (!bytes) throw winrt::hresult_error(E_POINTER);
                std::memcpy(bytes, frame.data(), kNv12Bytes);
                SoftwareBitmap bitmap = SoftwareBitmap::CreateCopyFromBuffer(buffer, BitmapPixelFormat::Nv12, kWidth, kHeight);
                VideoFrame videoFrame = VideoFrame::CreateWithSoftwareBitmap(bitmap);
                auto faces = tracker.ProcessNextFrameAsync(videoFrame).get();
                target.count = static_cast<LONG>(faces.Size());
                if (target.count > 0) {
                    const LONG mode = state.targetMode.load();
                    uint32_t minX=kWidth, minY=kHeight, maxX=0, maxY=0;
                    uint64_t bestMetric = 0;
                    BitmapBounds best{};
                    for (auto const& face : faces) {
                        BitmapBounds box = face.FaceBox();
                        if (box.X < minX) minX=box.X; if (box.Y < minY) minY=box.Y;
                        if (box.X + box.Width > maxX) maxX=box.X+box.Width;
                        if (box.Y + box.Height > maxY) maxY=box.Y+box.Height;
                        uint64_t metric = static_cast<uint64_t>(box.Width) * box.Height;
                        if (mode == static_cast<LONG>(CameraControls::TargetMode::CenterFace)) {
                            LONG cx=static_cast<LONG>(box.X + box.Width/2); LONG cy=static_cast<LONG>(box.Y + box.Height/2);
                            LONG dx=AbsLong(cx-static_cast<LONG>(kWidth/2)); LONG dy=AbsLong(cy-static_cast<LONG>(kHeight/2));
                            metric = static_cast<uint64_t>(1000000 - ((dx+dy) > 999999 ? 999999 : (dx+dy)));
                        }
                        if (metric > bestMetric) { bestMetric=metric; best=box; }
                    }
                    if (mode == static_cast<LONG>(CameraControls::TargetMode::Group) && target.count > 1) {
                        target.x=static_cast<LONG>((minX+maxX)/2); target.y=static_cast<LONG>((minY+maxY)/2);
                        target.width=static_cast<LONG>(maxX-minX); target.height=static_cast<LONG>(maxY-minY);
                    } else {
                        target.x=static_cast<LONG>(best.X+best.Width/2); target.y=static_cast<LONG>(best.Y+best.Height/2);
                        target.width=static_cast<LONG>(best.Width); target.height=static_cast<LONG>(best.Height);
                    }
                    target.valid=true; lastFace=now;
                }
            } catch (const winrt::hresult_error& e) {
                state.lastControlHresult.store(e.code());
            }
        }

        state.faceCount.store(target.count);
        if (target.valid) {
            state.faceCenterX.store(target.x); state.faceCenterY.store(target.y);
            state.faceWidth.store(target.width); state.faceHeight.store(target.height);
        } else {
            state.faceWidth.store(0); state.faceHeight.store(0);
            faceErrorReady = false;
        }

        if (state.autoFraming.load()) {
            LONG speed = CameraControls::ClampLong(state.trackingSpeed.load(), 1, 100);
            double alpha = 0.10 + (static_cast<double>(speed) / 100.0) * 0.45;
            if (target.valid) {
                LONG dead = CameraControls::ClampLong(state.deadZonePercent.load(), 4, 35);
                LONG dx = target.x - static_cast<LONG>(kWidth/2);
                LONG dy = target.y - static_cast<LONG>(kHeight/2);
                if (!faceErrorReady) {
                    filteredFaceDy = static_cast<double>(dy);
                    faceErrorReady = true;
                } else {
                    filteredFaceDy += (static_cast<double>(dy) - filteredFaceDy) * kFaceErrorFilterAlpha;
                }
                const LONG controlledDy = RoundLong(filteredFaceDy);
                LONG deadX = static_cast<LONG>((kWidth * dead) / 200);
                LONG deadY = kFaceVerticalDeadZonePixels;

                LONG wantedPan = state.panDegrees.load();
                if (AbsLong(dx) > deadX) wantedPan = CameraControls::ClampLong((dx * kPanMaximum) / static_cast<LONG>(kWidth/2), kPanMinimum, kPanMaximum);
                LONG currentPan = state.panDegrees.load();
                state.panDegrees.store(CameraControls::ClampLong(RoundLong(currentPan + (wantedPan-currentPan)*alpha), kPanMinimum, kPanMaximum));

                LONG limit = CameraControls::ClampLong(state.digitalZoomLimitPercent.load(), 100, 200) * 10;
                LONG wantedZoom = 1000;
                if (target.width > 0 && target.height > 0) {
                    LONG byWidth = static_cast<LONG>((static_cast<int64_t>(kWidth) * 1000) / (target.width * 2 + 1));
                    LONG byHeight = static_cast<LONG>((static_cast<int64_t>(kHeight) * 1000) / (target.height * 3 + 1));
                    wantedZoom = byWidth < byHeight ? byWidth : byHeight;
                    wantedZoom = CameraControls::ClampLong(wantedZoom, 1000, limit);
                }
                LONG currentZoom=state.zoomPermille.load();
                state.zoomPermille.store(CameraControls::ClampLong(RoundLong(currentZoom+(wantedZoom-currentZoom)*alpha),1000,limit));

                // A small digital vertical correction hides the mechanical motor's coarse/slower movement.
                LONG desiredVertical = CameraControls::ClampLong((controlledDy * 1200) / static_cast<LONG>(kHeight/2), -650, 650);
                LONG currentVertical = state.verticalCropPermille.load();
                state.verticalCropPermille.store(CameraControls::ClampLong(RoundLong(currentVertical+(desiredVertical-currentVertical)*alpha),-650,650));

                // FaceTracker remains the composition controller. The physical
                // accelerometer is a low-authority feed-forward term: it measures
                // a change in camera pitch relative to gravity and rejects base
                // motion before the face has time to drift far from center.
                double rawAccelCorrection = 0.0;
                const bool physicalMotor = state.motorTransport.load() == static_cast<LONG>(Control::Transport::PhysicalMotor);
                const bool stabilizationEnabled = state.tiltStabilization.load() != 0 && physicalMotor &&
                                                  accelReady && accelTiltSign != 0 &&
                                                  now - lastGoodAccel <= kAccelFreshMs;
                if (stabilizationEnabled) {
                    const LONG currentTiltForAccel = state.tiltDegrees.load();
                    const double expectedPitch = accelMountBias +
                        static_cast<double>(accelTiltSign * currentTiltForAccel);
                    const double disturbance = filteredAccelPitch - expectedPitch;
                    if (std::abs(disturbance) > kAccelDeadbandDegrees) {
                        const double strength = static_cast<double>(CameraControls::ClampLong(state.stabilizationStrength.load(),1,100)) / 100.0;
                        rawAccelCorrection = ClampDouble(-disturbance * static_cast<double>(accelTiltSign) *
                            (0.35 + 0.65 * strength), -kAccelMaximumCorrectionDegrees,
                            kAccelMaximumCorrectionDegrees);
                    }
                }
                filteredAccelCorrection += (rawAccelCorrection - filteredAccelCorrection) * kAccelCorrectionFilterAlpha;
                if (std::abs(filteredAccelCorrection) < 0.05) filteredAccelCorrection = 0.0;
                const double accelCorrection = filteredAccelCorrection;
                state.stabilizationCorrectionTenths.store(RoundLong(accelCorrection * 10.0));

                const bool faceNeedsTilt = AbsLong(controlledDy) > deadY;
                const bool accelNeedsTilt = std::abs(accelCorrection) >= 0.50;
                const LONG currentTilt = lastReportedTilt != 999 ? lastReportedTilt : state.tiltDegrees.load();
                const bool motorSettling = lastTiltSent != 999 &&
                    AbsLong(currentTilt - lastTiltSent) > kMotorSettleToleranceDegrees &&
                    now - lastTilt < kMotorSettleMs;
                if ((faceNeedsTilt || accelNeedsTilt) && !motorSettling &&
                    state.motorTransport.load() != 0 && now-lastTilt >= kTiltPeriodMs) {
                    // Fast absolute-angle closed loop. Face error supplies the
                    // framing target; accelerometer feed-forward adds only the
                    // gravity-referenced disturbance rejection term.
                    if (!faceTiltTargetReady) {
                        faceTiltTarget = static_cast<double>(currentTilt);
                        faceTiltTargetReady = true;
                    }
                    const double normalizedY = static_cast<double>(controlledDy) / static_cast<double>(kHeight / 2);
                    const double authority = 5.0 + (static_cast<double>(speed) / 100.0) * 15.0;
                    double faceCorrection = faceNeedsTilt ? normalizedY * authority : 0.0;
                    if (faceNeedsTilt && std::abs(faceCorrection) < 1.00) faceCorrection = controlledDy > 0 ? 1.00 : -1.00;
                    if (faceNeedsTilt) {
                        // Re-anchor each command on the measured physical angle. This
                        // is deliberately fast, but it never integrates the same face
                        // error repeatedly while the motor is still travelling.
                        faceTiltTarget = ClampDouble(static_cast<double>(currentTilt) - faceCorrection,
                                                     static_cast<double>(kTiltMinimum),
                                                     static_cast<double>(kTiltMaximum));
                    }
                    LONG wantedTilt = CameraControls::ClampLong(
                        RoundLong(faceTiltTarget + accelCorrection),
                        kTiltMinimum, kTiltMaximum);
                    LONG priorTarget = (lastTiltSent == 999) ? currentTilt : lastTiltSent;
                    const double motorAlpha = 0.55 + (static_cast<double>(speed) / 100.0) * 0.40;
                    const LONG maxMotorStep = 3 + (speed * 9) / 100;
                    LONG requestedStep = RoundLong((wantedTilt - priorTarget) * motorAlpha);
                    requestedStep = CameraControls::ClampLong(requestedStep, -maxMotorStep, maxMotorStep);
                    LONG smoothTarget = CameraControls::ClampLong(
                        priorTarget + requestedStep, kTiltMinimum, kTiltMaximum);
                    if (smoothTarget == priorTarget && wantedTilt != priorTarget)
                        smoothTarget += wantedTilt > priorTarget ? 1 : -1;
                    if (lastTiltSent == 999 || AbsLong(smoothTarget - lastTiltSent) >= kMinCommandDeltaDegrees) {
                        HRESULT hr=SendControl(Control::Command::Tilt,smoothTarget,nullptr,50);
                        state.lastControlHresult.store(hr);
                        if (SUCCEEDED(hr)) {
                            lastTiltSent=smoothTarget;
                            lastTilt=now;
                        }
                    }
                }
            } else if (now-lastFace >= kNoFaceRelaxMs) {
                filteredAccelCorrection = 0.0;
                state.stabilizationCorrectionTenths.store(0);
                if (accelReady && now-lastGoodAccel <= kAccelFreshMs &&
                    state.motorTransport.load() == static_cast<LONG>(Control::Transport::PhysicalMotor)) {
                    if (accelTiltSign != 0) {
                        const double neutral = filteredAccelPitch -
                            static_cast<double>(accelTiltSign * state.tiltDegrees.load());
                        accelMountBias += (neutral - accelMountBias) * kAccelBaselineAlpha;
                    }
                }
                LONG p=state.panDegrees.load(); LONG z=state.zoomPermille.load(); LONG v=state.verticalCropPermille.load();
                state.panDegrees.store(RoundLong(p*0.88));
                state.zoomPermille.store(1000 + RoundLong((z-1000)*0.88));
                state.verticalCropPermille.store(RoundLong(v*0.88));
                const LONG measuredTilt = lastReportedTilt != 999 ? lastReportedTilt : state.tiltDegrees.load();
                const bool motorSettling = lastTiltSent != 999 &&
                    AbsLong(measuredTilt - lastTiltSent) > kMotorSettleToleranceDegrees &&
                    now - lastTilt < kMotorSettleMs;
                if (state.autoCenter.load() && now-lastFace >= kNoFaceCenterMs && state.motorTransport.load()!=0 &&
                    AbsLong(measuredTilt - kStartupTiltDegrees) >= kMinCommandDeltaDegrees &&
                    !motorSettling && now-lastTilt>=kTiltPeriodMs) {
                    const HRESULT hr=SendControl(Control::Command::Tilt,kStartupTiltDegrees,nullptr,50);
                    state.lastControlHresult.store(hr);
                    if (SUCCEEDED(hr)) {
                        lastTiltSent=kStartupTiltDegrees;
                        faceTiltTarget=static_cast<double>(kStartupTiltDegrees);
                        faceTiltTargetReady=true;
                        lastTilt=now;
                    }
                }
            }
        } else {
            faceTiltTargetReady = false;
            faceErrorReady = false;
            filteredAccelCorrection = 0.0;
            state.stabilizationCorrectionTenths.store(0);
            if (accelReady && now-lastGoodAccel <= kAccelFreshMs &&
                state.motorTransport.load() == static_cast<LONG>(Control::Transport::PhysicalMotor)) {
                if (accelTiltSign != 0) {
                    const double neutral = filteredAccelPitch -
                        static_cast<double>(accelTiltSign * state.tiltDegrees.load());
                    accelMountBias += (neutral - accelMountBias) * kAccelBaselineAlpha;
                }
            }
            // Manual Tilt set through the standard camera control is delivered here.
            LONG targetTilt=CameraControls::ClampLong(state.tiltDegrees.load(),kTiltMinimum,kTiltMaximum);
            const LONG measuredTilt = lastReportedTilt != 999 ? lastReportedTilt : targetTilt;
            const bool motorSettling = lastTiltSent != 999 &&
                AbsLong(measuredTilt - lastTiltSent) > kMotorSettleToleranceDegrees &&
                now - lastTilt < kMotorSettleMs;
            if (state.motorTransport.load()!=0 && !motorSettling &&
                (lastTiltSent == 999 || AbsLong(targetTilt-lastTiltSent) >= kMinCommandDeltaDegrees) &&
                now-lastTilt>=kTiltPeriodMs) {
                HRESULT hr=SendControl(Control::Command::Tilt,targetTilt,nullptr,50);
                state.lastControlHresult.store(hr);
                if (SUCCEEDED(hr)) { lastTiltSent=targetTilt; lastTilt=now; }
            }
        }

        for (DWORD slept=0; slept<kFacePeriodMs && m_engineRun.load(); slept+=10) Sleep(10);
    }

    if (mappingBase) UnmapViewOfFile(mappingBase);
    if (mapping) CloseHandle(mapping);
    state.engineOnline.store(0);
    winrt::uninit_apartment();
}

void SimpleFrameGenerator::CloseMapping()
{
    if (m_base) UnmapViewOfFile(m_base);
    if (m_mapping) CloseHandle(m_mapping);
    m_base = nullptr;
    m_mapping = nullptr;
}
