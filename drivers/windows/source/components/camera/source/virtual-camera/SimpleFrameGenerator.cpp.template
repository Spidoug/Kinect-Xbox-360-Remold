constexpr LONG kPanMinimum = -30;
constexpr LONG kPanMaximum = 30;
constexpr LONG kTiltMinimum = __REMOLD_TILT_MIN__;
constexpr LONG kTiltMaximum = __REMOLD_TILT_MAX__;
constexpr LONG kStartupTiltDegrees = __REMOLD_STARTUP_TILT__;
constexpr LONG kFaceVerticalDeadZonePixels = __REMOLD_FACE_VERTICAL_DEAD_ZONE_PIXELS__;
constexpr LONG kZoomMinimumPermille = 1000;
constexpr LONG kZoomMaximumPermille = 2000;
constexpr DWORD kFacePeriodMs = __REMOLD_FACE_PERIOD_MS__;
constexpr DWORD kStatusPeriodMs = __REMOLD_STATUS_PERIOD_MS__;
constexpr DWORD kCameraActivityHeartbeatMs = __REMOLD_ACTIVITY_HEARTBEAT_MS__;
constexpr ULONGLONG kVirtualCameraActiveLeaseMs = __REMOLD_ACTIVITY_LEASE_MS__ULL;
constexpr DWORD kTiltPeriodMs = __REMOLD_TILT_COMMAND_PERIOD_MS__;
constexpr DWORD kNoFaceRelaxMs = 2000;
constexpr DWORD kNoFaceCenterMs = 8000;
constexpr double kAccelCountsPerG = 819.0;
constexpr double kAccelMinimumG = 0.65;
constexpr double kAccelMaximumG = 1.35;
constexpr double kAccelFilterAlpha = __REMOLD_ACCEL_FILTER_ALPHA__;
constexpr double kAccelBaselineAlpha = 0.025;
constexpr double kAccelDeadbandDegrees = 0.35;
constexpr double kAccelMaximumCorrectionDegrees = 5.0;
constexpr ULONGLONG kAccelFreshMs = 500;
constexpr double kFaceErrorFilterAlpha = __REMOLD_FACE_ERROR_FILTER_ALPHA__;
constexpr double kAccelCorrectionFilterAlpha = __REMOLD_ACCEL_CORRECTION_FILTER_ALPHA__;
constexpr LONG kMinCommandDeltaDegrees = __REMOLD_MIN_COMMAND_DELTA_DEGREES__;
constexpr LONG kMotorSettleToleranceDegrees = __REMOLD_MOTOR_SETTLE_TOLERANCE_DEGREES__;
constexpr DWORD kMotorSettleMs = __REMOLD_MOTOR_SETTLE_MS__;

LONG AbsLong(LONG value) noexcept { return value < 0 ? -value : value; }
LONG RoundLong(double value) noexcept { return static_cast<LONG>(value >= 0.0 ? value + 0.5 : value - 0.5); }
double ClampDouble(double value, double minimum, double maximum) noexcept {
    if (value < minimum) return minimum;
    if (value > maximum) return maximum;
    return value;
}

bool AccelPitchDegrees(LONG x, LONG y, LONG z, double& pitch) noexcept
{
    // Kinect's KXSD9 path is nominally 819 counts/g. Reject samples whose
    // vector magnitude says the sensor is undergoing strong linear motion;
    // gravity-only pitch compensation must never chase a bump or impact.
    const double fx = static_cast<double>(x);
    const double fy = static_cast<double>(y);
    const double fz = static_cast<double>(z);
    const double magnitude = std::sqrt(fx * fx + fy * fy + fz * fz);
    if (magnitude < kAccelCountsPerG * kAccelMinimumG ||
        magnitude > kAccelCountsPerG * kAccelMaximumG) return false;
    const double normalizedZ = ClampDouble(fz / magnitude, -1.0, 1.0);
    pitch = std::asin(normalizedZ) * (180.0 / 3.14159265358979323846);
    return std::isfinite(pitch);
}

HRESULT PipeExchange(const Control::Request& request, Control::Reply& reply, DWORD waitMs = 80)
{
    if (!WaitNamedPipeW(Control::kPipeName, waitMs)) return HRESULT_FROM_WIN32(GetLastError());
    HANDLE pipe = CreateFileW(Control::kPipeName, GENERIC_READ | GENERIC_WRITE, 0, nullptr,
                              OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
    if (pipe == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32(GetLastError());
    DWORD mode = PIPE_READMODE_MESSAGE;
    (void)SetNamedPipeHandleState(pipe, &mode, nullptr, nullptr);
    DWORD done = 0;
    HRESULT hr = S_OK;
    if (!WriteFile(pipe, &request, sizeof(request), &done, nullptr) || done != sizeof(request)) {
        hr = HRESULT_FROM_WIN32(GetLastError());
    } else if (!ReadFile(pipe, &reply, sizeof(reply), &done, nullptr) || done != sizeof(reply)) {
        hr = HRESULT_FROM_WIN32(GetLastError());
    } else if (reply.magic != Control::kMagic || reply.version != Control::kVersion) {
        hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
    } else {
        hr = static_cast<HRESULT>(reply.result);
    }
    CloseHandle(pipe);
    return hr;
}

HRESULT SendControl(Control::Command command, LONG value, Control::Reply* output = nullptr, DWORD waitMs = 80)
{
    Control::Request request{};
    request.command = command;
    request.value = value;
    Control::Reply reply{};
    HRESULT hr = PipeExchange(request, reply, waitMs);
    if (output) *output = reply;
    return hr;
}

bool CopyLatestNv12FromMapping(HANDLE mapping, const void* base, std::vector<BYTE>& destination)
{
    if (!mapping || !base || destination.size() != kNv12Bytes) return false;
    const auto* h = static_cast<const SharedHeader*>(base);
    if (h->magic != kMagic || h->version != kVersion || h->frameBytes != kNv12Bytes) return false;
    for (int attempt = 0; attempt < 4; ++attempt) {
        const LONG seq1 = h->sequence;
        MemoryBarrier();
        if (seq1 & 1) { SwitchToThread(); continue; }
        if (!h->online) return false;
        const LONG slot = h->activeSlot;
        if (slot < 0 || slot >= static_cast<LONG>(kSlotCount)) return false;
        const FrameSlotMeta meta = h->slot[slot];
        if (meta.bytes != kNv12Bytes || meta.tickMs == 0 || GetTickCount64() - meta.tickMs > 2000) return false;
        std::memcpy(destination.data(), SlotAddress(base, static_cast<uint32_t>(slot)), kNv12Bytes);
        MemoryBarrier();
        const LONG seq2 = h->sequence;
        if (seq1 == seq2 && !(seq2 & 1)) return true;
    }
    return false;
}

struct FaceTarget {
    bool valid = false;
    LONG count = 0;
    LONG x = 320;
    LONG y = 240;
    LONG width = 0;
    LONG height = 0;
};
