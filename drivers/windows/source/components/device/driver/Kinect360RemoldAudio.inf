; Kinect Xbox 360 Remold - NUI Audio boot transport
; USB\VID_045E&PID_02AD is bound only to Microsoft's inbox WinUSB stack.
; Kinect360RemoldAudioBridge uploads the Microsoft Kinect SDK UACFirmware in
; user mode. The device then re-enumerates as USB\VID_045E&PID_02BB; MI_02 is
; a USB Audio Class interface handled by Microsoft USB Audio class driver.
; No authored Remold kernel-mode audio driver, filter, WaveRT miniport,
; or other custom audio kernel component is installed by this package.

[Version]
Signature   = "$Windows NT$"
Class       = Kinect360RemoldInternal
ClassGuid   = {E0488A13-A670-423D-BD1B-168DDD4BD596}
Provider    = %ProviderName%
CatalogFile = Kinect360RemoldAudio.cat
DriverVer   = 08/21/2026,1.0.0.0
PnpLockdown = 1

[ClassInstall32]
AddReg = RemoldInternalClass.Registry

[RemoldInternalClass.Registry]
HKR,,,,%InternalClassName%
HKR,,NoDisplayClass,,1

[DestinationDirs]
AudioRuntime.Copy = 13

[SourceDisksNames]
1 = %DiskName%,,,,

[SourceDisksFiles]
Kinect360RemoldAudioBridge.exe = 1,,

[Manufacturer]
%ProviderName% = RemoldAudioModels,NTamd64.10.0...22000

[RemoldAudioModels.NTamd64.10.0...22000]
%RemoldAudio.DeviceDesc% = RemoldAudio_Install, USB\VID_045E&PID_02AD

[RemoldAudio_Install.NT]
Include = winusb.inf
Needs   = WINUSB.NT
CopyFiles = AudioRuntime.Copy

[RemoldAudio_Install.NT.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services
AddService = Kinect360RemoldAudioBridge,0x00000810,Kinect360RemoldAudioBridge.Service

[RemoldAudio_Install.NT.HW]
AddReg = RemoldAudio.Interface,RemoldAudio.Power,RemoldAudio.Security

[RemoldAudio.Interface]
HKR,,DeviceInterfaceGUIDs,0x00010000,"{67965F38-6818-4A56-B53E-8DF92F2EEBDE}"

[RemoldAudio.Power]
HKR,,DeviceIdleEnabled,0x00010001,0
HKR,,DefaultIdleState,0x00010001,0
HKR,,SystemWakeEnabled,0x00010001,0

[RemoldAudio.Security]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;AU)"

[Kinect360RemoldAudioBridge.Service]
DisplayName   = %AudioBridge.DisplayName%
Description   = %AudioBridge.Description%
ServiceType   = 0x10
StartType     = 0x3
ErrorControl  = 0x1
ServiceBinary = %13%\Kinect360RemoldAudioBridge.exe
AddTrigger    = AudioBridge.DeviceTrigger

[AudioBridge.DeviceTrigger]
TriggerType = 1
Action      = 1
SubType     = %AudioTransport.InterfaceGuid%

[AudioRuntime.Copy]
Kinect360RemoldAudioBridge.exe

[Strings]
ProviderName = "Douglas Santana (@spidoug)"
InternalClassName = "Kinect Xbox 360 Internal"
DiskName = "Xbox NUI Audio Remold WinUSB UAC Boot"
RemoldAudio.DeviceDesc = "Xbox NUI Audio - Remold UAC Boot Transport"
AudioBridge.DisplayName = "Xbox NUI Audio Remold Bridge"
AudioBridge.Description = "Uploads Microsoft Kinect UACFirmware through WinUSB, captures the 4-channel Kinect USB Audio endpoint through WASAPI, and publishes the Remold raw microphone pipe."
AudioTransport.InterfaceGuid = "{67965F38-6818-4A56-B53E-8DF92F2EEBDE}"
