; Kinect Xbox 360 Remold - NUI Audio boot transport
; 02AD: WinUSB boot path used only to upload Microsoft Kinect UACFirmware.
; 02BB/02C3&MI_00 is handled by Kinect360Remold1473Control.inf (or Microsoft's
; Kinect Audio Array Control WinUSB package when already installed).
; 02BB/02C3&MI_02 remains on Microsoft inbox USB Audio and is captured with WASAPI.
; 02C2 is never matched; it remains on the Microsoft inbox USB hub driver.

[Version]
Signature   = "$Windows NT$"
Class       = Kinect360RemoldInternal
ClassGuid   = {E0488A13-A670-423D-BD1B-168DDD4BD596}
Provider    = %ProviderName%
CatalogFile = Kinect360RemoldAudio.cat
DriverVer   = 08/29/2026,1.0.0.0
PnpLockdown = 1

[ClassInstall32]
AddReg = RemoldInternalClass.Registry

[RemoldInternalClass.Registry]
HKR,,,,%InternalClassName%
HKR,,NoDisplayClass,,1

[DestinationDirs]
AudioRuntime.Copy = 13

[SourceDisksNames]
1 = %DiskName%,,,,

[SourceDisksFiles]
Kinect360RemoldAudioBridge.exe = 1,,

[Manufacturer]
%ProviderName% = RemoldAudioModels,NTamd64.10.0...22000

[RemoldAudioModels.NTamd64.10.0...22000]
%RemoldAudio.BootDeviceDesc% = RemoldAudioBoot_Install, USB\VID_045E&PID_02AD

[RemoldAudioBoot_Install.NT]
Include = winusb.inf
Needs   = WINUSB.NT
CopyFiles = AudioRuntime.Copy

[RemoldAudioBoot_Install.NT.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services
AddService = Kinect360RemoldAudioBridge,0x00000810,Kinect360RemoldAudioBridge.Service

[RemoldAudioBoot_Install.NT.HW]
AddReg = RemoldAudioBoot.Interface,RemoldAudio.Power,RemoldAudio.Security

[RemoldAudioBoot.Interface]
HKR,,DeviceInterfaceGUIDs,0x00010000,"{67965F38-6818-4A56-B53E-8DF92F2EEBDE}"

[RemoldAudio.Power]
HKR,,DeviceIdleEnabled,0x00010001,0
HKR,,DefaultIdleState,0x00010001,0
HKR,,SystemWakeEnabled,0x00010001,0

[RemoldAudio.Security]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;AU)"

[Kinect360RemoldAudioBridge.Service]
DisplayName   = %AudioBridge.DisplayName%
Description   = %AudioBridge.Description%
ServiceType   = 0x10
StartType     = 0x3
ErrorControl  = 0x1
ServiceBinary = %13%\Kinect360RemoldAudioBridge.exe
AddTrigger    = AudioBridge.DeviceTrigger

[AudioBridge.DeviceTrigger]
TriggerType = 1
Action      = 1
SubType     = %AudioBootTransport.InterfaceGuid%

[AudioRuntime.Copy]
Kinect360RemoldAudioBridge.exe

[Strings]
ProviderName = "Douglas Santana (@spidoug)"
InternalClassName = "Kinect Xbox 360 Internal"
DiskName = "Xbox NUI Audio Remold WinUSB boot transport"
RemoldAudio.BootDeviceDesc = "Xbox NUI Audio - Remold UAC Boot Transport"
AudioBridge.DisplayName = "Xbox NUI Audio Remold Bridge"
AudioBridge.Description = "Uploads Microsoft Kinect Runtime v1.8 UACFirmware 01.02.709.00 through WinUSB, captures the 4-channel Kinect USB Audio endpoint through WASAPI, and publishes the Remold raw microphone pipe."
AudioBootTransport.InterfaceGuid = "{67965F38-6818-4A56-B53E-8DF92F2EEBDE}"
