; Kinect360RemoldDevice.inf
; Visible product identity and persistent control broker for Kinect Xbox 360 Remold.
; Physical Motor/Camera/Audio functions use the Microsoft inbox WinUSB driver. This visible root device hosts the broker.

[Version]
Signature   = "$Windows NT$"
Class       = KinectXbox360
ClassGuid   = {EF19BCED-3853-4DD9-8E3A-D536DDBED836}
Provider    = %ProviderName%
CatalogFile = Kinect360RemoldDevice.cat
DriverVer   = 08/29/2026,1.0.0.0
PnpLockdown = 1

[ClassInstall32]
AddReg = KinectClass.Registry

[KinectClass.Registry]
HKR,,,,%ClassName%
HKR,,Icon,,-20

[DestinationDirs]
BrokerRuntime.Copy = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
Kinect360RemoldBroker.exe = 1,,

[Manufacturer]
%ProviderName% = RemoldDeviceModels,NTamd64.10.0...22000

[RemoldDeviceModels.NTamd64.10.0...22000]
%RemoldDevice.DeviceDesc% = RemoldDevice_Install, ROOT\Kinect360RemoldDevice

[RemoldDevice_Install.NT]
CopyFiles = BrokerRuntime.Copy

[RemoldDevice_Install.NT.Services]
AddService = ,2
AddService = Kinect360RemoldBroker,0x00000800,Kinect360RemoldBroker.Service

[RemoldDevice_Install.NT.HW]
AddReg = RemoldDevice.Interface

[RemoldDevice.Interface]
HKR,,DeviceInterfaceGUIDs,0x00010000,"{D5F54F4C-E0BC-480B-A2B7-93BD0D1B4A10}"

[Kinect360RemoldBroker.Service]
DisplayName   = %Broker.DisplayName%
Description   = %Broker.Description%
ServiceType   = 0x10
StartType     = 0x2
ErrorControl  = 0x1
ServiceBinary = %13%\Kinect360RemoldBroker.exe

[BrokerRuntime.Copy]
Kinect360RemoldBroker.exe

[Strings]
ProviderName = "Douglas Santana (@spidoug)"
DiskName = "Kinect Xbox 360 Remold Device"
ClassName = "Kinect Xbox 360"
RemoldDevice.DeviceDesc = "Kinect Xbox 360 Remold"
Broker.DisplayName = "Kinect Xbox 360 Remold Broker"
Broker.Description = "Coordinates Kinect camera activity, physical motor control, and LED policy."
