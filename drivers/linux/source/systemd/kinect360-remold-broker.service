[Unit]
StartLimitIntervalSec=30
StartLimitBurst=5
Description=Kinect 360 Remold motor/control broker
PartOf=kinect360-remold.target
After=systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/libexec/kinect360-remold/kinect360-remold-broker
Restart=on-failure
RestartSec=1

[Install]
WantedBy=kinect360-remold.target
