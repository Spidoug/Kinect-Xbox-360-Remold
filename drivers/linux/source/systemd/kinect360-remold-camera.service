[Unit]
StartLimitIntervalSec=30
StartLimitBurst=5
Description=Kinect 360 Remold RGB/IR/depth bridge
PartOf=kinect360-remold.target
After=systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/libexec/kinect360-remold/kinect360-remold-camera
Restart=on-failure
RestartSec=1

[Install]
WantedBy=kinect360-remold.target
